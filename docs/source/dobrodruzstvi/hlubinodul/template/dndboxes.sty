% dndboxes.sty - custom boxes for the D&D adventure pandoc pipeline.
% Depends on the dnd package being loaded first (provides tcolorbox + colors).
% Local to this repo; not part of the upstream DND-5e-LaTeX-Template.
\ProvidesPackage{dndboxes}

% squarebox: titled callout, visually distinct (parchment tint, titlered rules)
% The title is passed by the filter as a tcolorbox key: [title={...}]
\newtcolorbox{squarebox}[1][]{%
  enhanced,
  breakable,
  boxsep=6pt,
  top=4pt, bottom=4pt, left=8pt, right=8pt,
  before skip=10pt, after skip=10pt,
  colback=bgtan,
  colframe=titlered,
  borderline north={1.2pt}{0pt}{titlered},
  borderline south={1.2pt}{0pt}{titlered},
  borderline west={0.4pt}{0pt}{titlegold},
  borderline east={0.4pt}{0pt}{titlegold},
  fonttitle=\large\bfseries,
  colbacktitle=bgtan,
  coltitle=titlered,
  #1}

% dnditem: item stat block — name as box title, type/rarity italic below it,
% then description text. Usage: \begin{dnditem}{Name}{Type, rarity} ... \end{dnditem}
% Styled like a small DndMonster: statblock tan bg, gold ribbon top/bottom.
\newtcolorbox{dnditem}[2]{%
  enhanced,
  breakable,
  boxsep=6pt,
  top=4pt, bottom=4pt, left=8pt, right=8pt,
  before skip=10pt, after skip=10pt,
  boxrule=0pt,
  colback=statblockbg,
  colframe=statblockribbon,
  borderline north={2pt}{0pt}{statblockribbon},
  borderline south={2pt}{0pt}{statblockribbon},
  colbacktitle=statblockbg,
  coltitle=titlered,
  fonttitle=\large\bfseries,
  fontupper=\DndFontStatBlockBody,
  title={#1},
  before upper={\textit{#2}\par\smallskip}}

% DndItemReadAloud: compact read-aloud box for use INSIDE dnditem/dndmonster
% boxes (a plain DndReadAloud would be tan-on-tan there). Parchment bg with a
% thin gold rule so the DM can spot player-readable text quickly.
\newtcolorbox{DndItemReadAloud}{%
  enhanced,
  breakable,
  boxsep=4pt,
  top=4pt, bottom=4pt, left=6pt, right=6pt,
  before skip=6pt, after skip=6pt,
  boxrule=0pt,
  colback=bgtan,
  borderline north={0.6pt}{0pt}{titlegold},
  borderline south={0.6pt}{0pt}{titlegold},
  borderline west={0.6pt}{0pt}{titlegold},
  borderline east={0.6pt}{0pt}{titlegold},
  fontupper=\DndFontStatBlockBody}

\endinput
