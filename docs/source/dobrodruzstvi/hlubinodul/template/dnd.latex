% Pandoc LaTeX template for D&D 5e adventures.
% Wraps rpgtex/DND-5e-LaTeX-Template (loaded unmodified via TEXMFHOME).
% -*- tex -*-
\documentclass[10pt,twoside,twocolumn]{article}
$if(lang)$
\usepackage[main=$lang$,english,czech]{babel}
$endif$
\usepackage[bg=full,justified]{dnd}
\usepackage{amsmath,amssymb}
\usepackage{fixltx2e} % provides \textsubscript
\usepackage[T1]{fontenc}
$if(colorlinks)$
\usepackage[
  unicode=true,
  bookmarks=true,
  colorlinks=true,
  linkcolor=$if(linkcolor)$$linkcolor$$else$titlered$endif$,
  urlcolor=$if(urlcolor)$$urlcolor$$else$titlered$endif$,
  citecolor=$if(citecolor)$$citecolor$$else$blue$endif$,
  pdftitle={$title-meta$},
  pdfauthor={$author-meta$},
  pdfborder={0 0 0}
]{hyperref}
$else$
\usepackage[unicode=true]{hyperref}
\hypersetup{
  colorlinks=false,
  breaklinks=true,
  bookmarks=true,
  pdftitle={$title-meta$},
  pdfauthor={$author-meta$},
  pdfborder={0 0 0}}
$endif$

\usepackage{dndboxes}  % squarebox, dnditem (this repo, template/dndboxes.sty)
\usepackage{dndczech}  % Czech DND strings (this repo, template/dndczech.sty)

$if(graphics)$
\usepackage{graphicx,grffile}
\makeatletter
\def\maxwidth{\ifdim\Gin@nat@width>\linewidth\linewidth\else\Gin@nat@width\fi}
\def\maxheight{\ifdim\Gin@nat@height>\textheight\textheight\else\Gin@nat@height\fi}
\makeatother
% Scale images so they never overflow the page
\setkeys{Gin}{width=\maxwidth,height=\maxheight,keepaspectratio}
$endif$

\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}
% pandoc >= 3.6 wraps images in this; our Gin scaling handles sizing
\providecommand{\pandocbounded}[1]{#1}

\begin{document}

$for(include-before)$
$include-before$
$endfor$

$if(title)$
\title{$title$$if(subtitle)$\subtitle{$subtitle$}$endif$}
$endif$
$if(author)$
\author{$author$}
$endif$
\date{$if(date)$$date$$else$\today$endif$}
% Title + TOC on a single-column page; body starts two-column after it
\onecolumn
\maketitle

$if(toc)$
{
\setcounter{tocdepth}{$if(toc-depth)$$toc-depth$$else$2$endif$}
\tableofcontents
}
$endif$
\twocolumn

$body$

$for(include-after)$
$include-after$
$endfor$

\end{document}
