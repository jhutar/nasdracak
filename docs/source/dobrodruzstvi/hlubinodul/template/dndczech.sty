    \renewcommand\spellseventhlevelname{7.~úrovně}
    \renewcommand\spelleighthlevelname{8.~úrovně}
    \renewcommand\spellninthlevelname{9.~úrovně}
    % Spell slots
    \renewcommand\spellatwillname{kdykoli}
    \renewcommand\spelloneslotname{1~slot}
    \renewcommand\spelltwoslotsname{2~sloty}
    \renewcommand\spellthreeslotsname{3~sloty}
    \renewcommand\spellfourslotsname{4~sloty}
    % Innate spellcasting
    \renewcommand\innateatwillname{Kdykoli}
    \renewcommand\numberperdayname{|1|/den}
    \renewcommand\numberperdayeachname{|1|/den~každé}
    % Spell header
    \renewcommand\spellcastingtimename{Čas~vržení}
